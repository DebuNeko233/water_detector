  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^5.4.0",
    "typescript": "^5.6.0",
    "vue-tsc": "^2.1.0",
    "electron": "^33.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "vite-plugin-electron": "^0.28.6"
  },
  "main": "dist-electron/main.js"
