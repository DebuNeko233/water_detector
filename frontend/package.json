{
  "name": "wafer-inspection-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "desktop": "node ../scripts/dev-desktop.cjs",
    "desktop:electron": "electron ../electron",
    "desktop:dist": "pnpm build && cross-env WAFER_USE_DIST=1 electron ../electron"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "pinia": "^2.2.0",
    "element-plus": "^2.9.0",
    "@element-plus/icons-vue": "^2.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^5.4.0",
    "typescript": "^5.6.0",
    "vue-tsc": "^2.1.0",
    "electron": "^33.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3"
  }
}
